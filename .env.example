# MINISTRE AI — fournisseurs IA
# Ne jamais committer de vraies clés dans GitHub.

# Ordre de préférence : modèle souverain/local d'abord, puis fournisseurs cloud gratuits pour la DEMO.
AI_PROVIDER_ORDER=local,gemini,openrouter

# --- Option 1 : Gemini API (free tier pour certains modèles) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- Option 2 : OpenRouter Free Models Router ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
APP_PUBLIC_URL=

# --- Cible souveraine / privée future ---
# Endpoint OpenAI-compatible (vLLM, Ollama gateway, TGI, etc.)
LOCAL_AI_BASE_URL=
LOCAL_AI_MODEL=local-model
LOCAL_AI_API_KEY=
